rules_version = '2';

// ============================================================
//  ALR SaaS Commander — Firestore Security Rules
//  El claim `alrSuperAdmin` SOLO lo asigna verifyAlrAdminAccess
//  (Cloud Function, Admin SDK) tras validar el PIN contra Secret
//  Manager — nunca lo decide el navegador. El status público que
//  consume alr-saas-gate-sdk.js en las apps cliente NO se sirve
//  desde aquí: lo sirve getPublicLicenseStatus (Cloud Function con
//  Admin SDK, que bypasea estas reglas) para no tener que abrir
//  lectura pública de master_licenses (que contiene apiKey, datos
//  de contacto, etc.).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAlrSuperAdmin() {
      return request.auth != null
        && request.auth.token.get('alrSuperAdmin', false) == true;
    }

    match /master_licenses/{licenseId} {
      allow read, write: if isAlrSuperAdmin();

      // apiKey (el secreto que firma/protege la licencia de cada
      // cliente) vive aparte del documento principal -- mismo control de
      // acceso (isAlrSuperAdmin), pero así un futuro bug que exponga
      // master_licenses/{id} por error no arrastra el apiKey con él.
      // Las subcolecciones NO heredan la regla del documento padre en
      // Firestore, necesitan su propio match.
      match /secrets/{docId} {
        allow read, write: if isAlrSuperAdmin();
      }
    }

    // Colecciones propias de la consola.
    match /alr-saas-settings/{docId} {
      allow read, write: if isAlrSuperAdmin();
    }
    match /alr-saas-security-alerts/{docId} {
      allow read, write: if isAlrSuperAdmin();
    }
    match /alr-saas-telemetry-logs/{docId} {
      allow read, write: if isAlrSuperAdmin();
    }
    match /alr_saas_sync_logs/{docId} {
      allow read, write: if isAlrSuperAdmin();
    }

    // Catálogo de apps con auto-clonado (registerTenant-equivalente por
    // app-type) que usa provisionAppClone -- webApiKey aquí NO es secreta
    // (ya vive pública en el app_config.js del propio cliente), pero se
    // protege igual que el resto de la consola por consistencia.
    match /alr-saas-app-registry/{appId} {
      allow read, write: if isAlrSuperAdmin();
    }

    // Catálogo de apps del Portafolio (nombre/icono/color/version/status).
    // Antes vivía SOLO en localStorage por navegador -- una app registrada
    // en un dispositivo "desaparecía" al entrar desde otro. Se sincroniza
    // aquí para que el catálogo sea el mismo en cualquier dispositivo.
    match /alr-saas-apps/{appId} {
      allow read, write: if isAlrSuperAdmin();
    }

    // Cuestionario colaborativo de SERO LAB (demo LIMS 4.0). Antes se
    // guardaba en un archivo en el disco de Render (api/telegram.js) --
    // efímero, se borraba en cada despliegue del servicio. Ahora vive aquí.
    // Se deja accesible con solo sesión anónima (igual que hoy: el POST del
    // navegador no pide ningún login) porque el objetivo es que cualquier
    // colaborador de SERO LAB pueda opinar sin fricción -- pero se valida
    // la forma del documento para que ni una sesión anónima pueda meter
    // basura arbitraria o campos gigantes.
    match /serolab_requirements/{moduleId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.moduleId is string
        && request.resource.data.uso is string && request.resource.data.uso.size() < 4000
        && request.resource.data.deseo is string && request.resource.data.deseo.size() < 4000
        && request.resource.data.submodules is list;
      // Borrar SÍ requiere admin -- una sesión anónima cualquiera puede
      // aportar (create/update), pero no puede borrar las respuestas que
      // ya dio el cliente.
      allow delete: if isAlrSuperAdmin();
    }

    // Sin match /{document=**} de respaldo: todo lo no cubierto
    // arriba queda denegado por defecto.
  }
}
